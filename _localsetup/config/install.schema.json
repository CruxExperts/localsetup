{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/install.schema.json",
  "title": "Localsetup v3 install config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platforms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": ["core"]
    },
    "preset": {
      "type": "string",
      "enum": ["core", "suggested", "all", "custom"],
      "description": "Named selection preset. Omit for the conservative core default in automation."
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Managed package-library baseline packs."
    },
    "global_preset": {
      "type": "string",
      "enum": ["core", "suggested", "all", "custom"],
      "description": "Managed package-library baseline preset."
    },
    "global_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "global_exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_packs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Repo-visible packs exposed through selected adapter paths."
    },
    "repo_preset": {
      "type": "string",
      "enum": ["core", "suggested", "all", "custom"],
      "description": "Repo-visible selection preset."
    },
    "repo_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_skill_classes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_skill_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "repo_exclude_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "attach_mode": {
      "type": "string",
      "enum": ["symlink", "portable"],
      "default": "symlink"
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "target_directory": {
      "type": "string",
      "minLength": 1,
      "description": "Directory where repo adapter links and .localsetup/lock.json are written. Defaults to the detected target."
    },
    "data_root": {
      "type": "string",
      "minLength": 1,
      "description": "Optional root for managed runtime state such as the managed dependency venv. Defaults to the Localsetup user data root, normally ~/.local/share/localsetup."
    },
    "dependency_mode": {
      "type": "string",
      "enum": ["managed-venv", "user-pip", "prompt-only"],
      "default": "managed-venv"
    },
    "migration_mode": {
      "type": "string",
      "enum": ["conservative-auto", "report-only"],
      "default": "conservative-auto"
    },
    "backup_dir": {
      "type": "string",
      "minLength": 1
    },
    "backup_policy": {
      "type": "string",
      "enum": ["timestamped"],
      "default": "timestamped"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json": {
          "type": "boolean",
          "default": true,
          "description": "Explicit JSON output preference. JSON is the default for non-Markdown commands."
        },
        "report": { "type": "string", "minLength": 1 },
        "markdown": { "type": "boolean", "default": false }
      }
    }
  }
}
