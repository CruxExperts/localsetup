#!/usr/bin/env bash
# Localsetup v3 front-end installer.
# Purpose: keep the stable shell entrypoint while delegating framework work to
# _localsetup/tools/localsetup_v3.py.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="."
HOME_DIR="${HOME}"
PLATFORMS_CSV=""
PACKS_CSV="core"
MODE="symlink"
YES=false
INSTALL_DEPS=false
MIN_PYTHON_VERSION="3.10.0"

usage() {
  cat <<'USAGE_END'
Localsetup v3 installer

Usage:
  ./install --directory . --yes
  ./install --directory . --tools codex,kilo --yes
  ./install --directory . --home /tmp/localsetup-home --yes
  ./install --directory . --platforms codex kilo --yes

Options:
  --directory PATH      Repo root containing _localsetup/ (default: .)
  --home PATH           Home directory for the managed shared skill library (default: $HOME)
  --yes                Non-interactive apply. Required for install.
  --tools LIST         Compatibility alias for --platforms. Comma-separated.
  --platforms LIST     Platform adapter ids. Defaults to every platform in platforms.yaml.
  --packs LIST         Skill packs to install. Comma-separated. Default: core.
  --mode MODE          symlink or portable. Default: symlink.
  --install-deps       Install Python dependencies from _localsetup/requirements.txt first.
  --upgrade-policy     Accepted for v2 compatibility; v3 uses managed install metadata.
  --global             Accepted for v2 compatibility; v3 installs the shared home library by default.
  --help, -h           Show this help.

Windows note:
  Localsetup v3 supports Windows through WSL2 only. Run this script inside WSL.
USAGE_END
}

die() {
  echo "Error: $*" >&2
  exit 1
}

csv_to_args() {
  local csv="$1"
  local -n out_ref="$2"
  local item trimmed
  IFS=',' read -r -a out_ref <<< "$csv"
  for i in "${!out_ref[@]}"; do
    item="${out_ref[$i]}"
    trimmed="${item#"${item%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -n "$trimmed" ]] || die "empty value in comma-separated list: $csv"
    out_ref[$i]="$trimmed"
  done
}

check_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  python3 - "$MIN_PYTHON_VERSION" <<'PY' || die "python3 >= 3.10 is required"
from __future__ import annotations

import sys

required = tuple(int(part) for part in sys.argv[1].split("."))
current = sys.version_info[:3]
raise SystemExit(0 if current >= required else 1)
PY
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --directory)
      [[ $# -ge 2 ]] || die "missing value for --directory"
      TARGET_DIR="$2"
      shift 2
      ;;
    --home)
      [[ $# -ge 2 ]] || die "missing value for --home"
      HOME_DIR="$2"
      shift 2
      ;;
    --tools)
      [[ $# -ge 2 ]] || die "missing value for --tools"
      PLATFORMS_CSV="$2"
      shift 2
      ;;
    --platforms)
      shift
      platform_values=()
      while [[ $# -gt 0 && "$1" != --* ]]; do
        platform_values+=("$1")
        shift
      done
      [[ ${#platform_values[@]} -gt 0 ]] || die "missing value for --platforms"
      PLATFORMS_CSV="$(IFS=,; echo "${platform_values[*]}")"
      ;;
    --packs)
      [[ $# -ge 2 ]] || die "missing value for --packs"
      PACKS_CSV="$2"
      shift 2
      ;;
    --mode)
      [[ $# -ge 2 ]] || die "missing value for --mode"
      MODE="$2"
      shift 2
      ;;
    --yes)
      YES=true
      shift
      ;;
    --install-deps)
      INSTALL_DEPS=true
      shift
      ;;
    --upgrade-policy)
      [[ $# -ge 2 ]] || die "missing value for --upgrade-policy"
      shift 2
      ;;
    --global)
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[[ "$YES" == true ]] || die "v3 install requires --yes. Use _localsetup/tools/localsetup_v3.py plan to preview."
[[ -d "$TARGET_DIR" ]] || die "directory does not exist: $TARGET_DIR"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
mkdir -p "$HOME_DIR"
HOME_DIR="$(cd "$HOME_DIR" && pwd)"
[[ -f "$TARGET_DIR/_localsetup/tools/localsetup_v3.py" ]] || die "missing v3 tool at $TARGET_DIR/_localsetup/tools/localsetup_v3.py"
check_python

case "$MODE" in
  symlink|portable) ;;
  *) die "invalid --mode: $MODE" ;;
esac

if "$INSTALL_DEPS"; then
  python3 -m pip install -r "$TARGET_DIR/_localsetup/requirements.txt"
fi

pack_args=()
csv_to_args "$PACKS_CSV" pack_args

platform_args=()
if [[ -n "$PLATFORMS_CSV" ]]; then
  csv_to_args "$PLATFORMS_CSV" platform_args
fi

cmd=(python3 "$TARGET_DIR/_localsetup/tools/localsetup_v3.py" --home "$HOME_DIR" --repo "$TARGET_DIR" install --apply --mode "$MODE" --packs "${pack_args[@]}")
if [[ ${#platform_args[@]} -gt 0 ]]; then
  cmd+=(--platforms "${platform_args[@]}")
fi

exec "${cmd[@]}"
