#!/usr/bin/env bash
# Localsetup v3 front-end installer.
# Purpose: keep the stable shell entrypoint while delegating framework work to
# _localsetup/tools/localsetup_v3.py.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_DIR="."
ATTACH_TARGET_DIR=""
HOME_DIR="${HOME}"
PLATFORMS_CSV=""
PACKS_CSV="core"
MODE="symlink"
YES=false
INSTALL_DEPS=false
REGISTER_SHELL=true
DEPENDENCY_MODE="prompt-only"
MIN_PYTHON_VERSION="3.10.0"

usage() {
  cat <<'USAGE_END'
Localsetup v3 installer

Usage:
  ./install --directory . --yes
  ./install --directory . --tools codex,kilo --yes
  ./install --directory /path/to/localsetup --target-directory /path/to/project --tools cursor --yes
  ./install --directory . --home /tmp/localsetup-home --yes
  ./install --directory . --platforms codex kilo --yes

Options:
  --directory PATH      Localsetup source checkout containing _localsetup/ (default: .)
  --target-directory PATH
                       Directory where adapter links and localsetup.lock.json are written.
                       Defaults to --directory. Omit --tools/--platforms for global-only install.
  --home PATH           Home directory for the managed shared skill library (default: $HOME)
  --yes                Non-interactive apply. Required for install.
  --tools LIST         Compatibility alias for --platforms. Comma-separated.
  --platforms LIST     Platform adapter ids. Omit for global-only install with no repo adapters.
  --packs LIST         Skill packs to install. Comma-separated. Default: core.
  --mode MODE          symlink or portable. Default: symlink.
  --install-deps       Create/update the managed venv and install _localsetup/requirements.txt.
  --no-register-shell  Do not create/update ~/.local/bin/localsetup.
  --upgrade-policy     Accepted for v2 compatibility; v3 uses managed install metadata.
  --global             Accepted for v2 compatibility; v3 installs the shared home library by default.
  --help, -h           Show this help.

Windows note:
  Localsetup v3 supports Windows through WSL2 only. Run this script inside WSL.
USAGE_END
}

die() {
  echo "Error: $*" >&2
  exit 1
}

csv_to_args() {
  local csv="$1"
  local -n out_ref="$2"
  local item trimmed
  IFS=',' read -r -a out_ref <<< "$csv"
  for i in "${!out_ref[@]}"; do
    item="${out_ref[$i]}"
    trimmed="${item#"${item%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -n "$trimmed" ]] || die "empty value in comma-separated list: $csv"
    out_ref[$i]="$trimmed"
  done
}

check_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required"
  python3 - "$MIN_PYTHON_VERSION" <<'PY' || die "python3 >= 3.10 is required"
from __future__ import annotations

import sys

required = tuple(int(part) for part in sys.argv[1].split("."))
current = sys.version_info[:3]
raise SystemExit(0 if current >= required else 1)
PY
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --directory)
      [[ $# -ge 2 ]] || die "missing value for --directory"
      SOURCE_DIR="$2"
      shift 2
      ;;
    --target-directory)
      [[ $# -ge 2 ]] || die "missing value for --target-directory"
      ATTACH_TARGET_DIR="$2"
      shift 2
      ;;
    --home)
      [[ $# -ge 2 ]] || die "missing value for --home"
      HOME_DIR="$2"
      shift 2
      ;;
    --tools)
      [[ $# -ge 2 ]] || die "missing value for --tools"
      PLATFORMS_CSV="$2"
      shift 2
      ;;
    --platforms)
      shift
      platform_values=()
      while [[ $# -gt 0 && "$1" != --* ]]; do
        platform_values+=("$1")
        shift
      done
      [[ ${#platform_values[@]} -gt 0 ]] || die "missing value for --platforms"
      PLATFORMS_CSV="$(IFS=,; echo "${platform_values[*]}")"
      ;;
    --packs)
      [[ $# -ge 2 ]] || die "missing value for --packs"
      PACKS_CSV="$2"
      shift 2
      ;;
    --mode)
      [[ $# -ge 2 ]] || die "missing value for --mode"
      MODE="$2"
      shift 2
      ;;
    --yes)
      YES=true
      shift
      ;;
    --install-deps)
      INSTALL_DEPS=true
      shift
      ;;
    --no-register-shell)
      REGISTER_SHELL=false
      shift
      ;;
    --upgrade-policy)
      [[ $# -ge 2 ]] || die "missing value for --upgrade-policy"
      shift 2
      ;;
    --global)
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[[ "$YES" == true ]] || die "v3 install requires --yes. Use _localsetup/tools/localsetup_v3.py plan to preview."
[[ -d "$SOURCE_DIR" ]] || die "directory does not exist: $SOURCE_DIR"
SOURCE_DIR="$(cd "$SOURCE_DIR" && pwd)"
target_args=()
if [[ -n "$ATTACH_TARGET_DIR" ]]; then
  mkdir -p "$ATTACH_TARGET_DIR"
  ATTACH_TARGET_DIR="$(cd "$ATTACH_TARGET_DIR" && pwd)"
  target_args=(--target-directory "$ATTACH_TARGET_DIR")
fi
mkdir -p "$HOME_DIR"
HOME_DIR="$(cd "$HOME_DIR" && pwd)"
[[ -f "$SOURCE_DIR/_localsetup/tools/localsetup_v3.py" ]] || die "missing v3 tool at $SOURCE_DIR/_localsetup/tools/localsetup_v3.py"
check_python

case "$MODE" in
  symlink|portable) ;;
  *) die "invalid --mode: $MODE" ;;
esac

if "$INSTALL_DEPS"; then
  DEPENDENCY_MODE="managed-venv"
fi

pack_args=()
csv_to_args "$PACKS_CSV" pack_args

platform_args=()
if [[ -n "$PLATFORMS_CSV" ]]; then
  csv_to_args "$PLATFORMS_CSV" platform_args
fi
if [[ -n "$ATTACH_TARGET_DIR" && ${#platform_args[@]} -eq 0 ]]; then
  echo "Warning: --target-directory was provided without --tools/--platforms; installing the managed library only and creating no repo adapters." >&2
fi

doctor_cmd=(python3 "$SOURCE_DIR/_localsetup/tools/localsetup_v3.py" --home "$HOME_DIR" --repo "$SOURCE_DIR" "${target_args[@]}" doctor --dependency-mode "$DEPENDENCY_MODE" --packs "${pack_args[@]}")
if [[ ${#platform_args[@]} -gt 0 ]]; then
  doctor_cmd+=(--platforms "${platform_args[@]}")
fi

if ! "${doctor_cmd[@]}" >/dev/null; then
  echo "Localsetup doctor found blockers. Re-run for details:" >&2
  printf ' %q' "${doctor_cmd[@]}" >&2
  echo >&2
  exit 1
fi

if "$REGISTER_SHELL"; then
  register_cmd=(python3 "$SOURCE_DIR/_localsetup/tools/localsetup_v3.py" --home "$HOME_DIR" --repo "$SOURCE_DIR" register-shell)
  if ! "${register_cmd[@]}" >/dev/null; then
    echo "Localsetup shell registration failed. Re-run for details:" >&2
    printf ' %q' "${register_cmd[@]}" >&2
    echo >&2
    exit 1
  fi
  case ":${PATH:-}:" in
    *":$HOME_DIR/.local/bin:"*) ;;
    *) echo "Warning: $HOME_DIR/.local/bin is not on PATH; add it before using the global localsetup command." >&2 ;;
  esac
  resolved_localsetup="$(command -v localsetup 2>/dev/null || true)"
  if [[ -n "$resolved_localsetup" && "$(cd "$(dirname "$resolved_localsetup")" && pwd)/$(basename "$resolved_localsetup")" != "$HOME_DIR/.local/bin/localsetup" ]]; then
    echo "Warning: localsetup resolves to $resolved_localsetup before the managed shim at $HOME_DIR/.local/bin/localsetup." >&2
  fi
fi

cmd=(python3 "$SOURCE_DIR/_localsetup/tools/localsetup_v3.py" --home "$HOME_DIR" --repo "$SOURCE_DIR" "${target_args[@]}" install --apply --dependency-mode "$DEPENDENCY_MODE" --mode "$MODE" --packs "${pack_args[@]}")
if [[ ${#platform_args[@]} -gt 0 ]]; then
  cmd+=(--platforms "${platform_args[@]}")
fi

exec "${cmd[@]}"
