# Agent work queue (local-only PRDs and task files; never publish)
.agent/

# Git state snapshots (unfuck-my-git-state diagnostic output; never publish)
.git-state-snapshots/

# Repo maintenance scripts (local-only, not shipped)
/scripts/

# Internal/maintainer docs (not shipped; public docs live in _localsetup/docs/)
docs/
!_localsetup/docs/
!_localsetup/docs/**

# Contribution artifacts (local-only, not shipped)
contributions/

