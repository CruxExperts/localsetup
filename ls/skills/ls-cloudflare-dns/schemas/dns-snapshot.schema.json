{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.invalid/schemas/cloudflare-dns/dns-snapshot.schema.json",
  "title": "Cloudflare DNS Snapshot",
  "type": "object",
  "required": ["zone", "record_count", "records", "snapshot_hash"],
  "properties": {
    "zone": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "record_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "content", "record_hash"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "content": { "type": "string" },
          "record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
