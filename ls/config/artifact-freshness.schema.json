{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/artifact-freshness.schema.json",
  "title": "LocalSetup artifact freshness metadata",
  "description": "Portable, source-backed freshness metadata for a managed artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "owner",
    "source",
    "target_state",
    "verification_date",
    "verification_method",
    "authoritative_sources",
    "review_interval_days",
    "risk_class"
  ],
  "properties": {
    "$schema": {
      "const": "https://localsetup.dev/schemas/artifact-freshness.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target_state": {
      "enum": [
        "versioned",
        "unversioned",
        "not_applicable"
      ]
    },
    "target_kind": {
      "type": "string",
      "minLength": 1
    },
    "target_name": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "target_reason": {
      "type": "string",
      "minLength": 1
    },
    "verification_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      }
    },
    "review_interval_days": {
      "type": "integer",
      "minimum": 1
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_state": {
            "const": "versioned"
          }
        }
      },
      "then": {
        "required": [
          "target_kind",
          "target_name",
          "target_version",
          "authoritative_sources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "target_state": {
            "enum": [
              "unversioned",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "required": [
          "target_reason"
        ],
        "not": {
          "required": [
            "target_version"
          ]
        }
      }
    }
  ]
}
