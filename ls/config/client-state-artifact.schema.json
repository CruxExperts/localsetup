{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsetup.dev/schemas/client-state-artifact.schema.json",
  "title": "LocalSetup client-state artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact", "checkpoint", "client", "consumers",
    "content", "created_at", "format", "kind", "predecessor", "producer", "schema"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"$ref": "#/$defs/filename"},
    "checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/relativePath"}]},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "registry_schema_version", "variant_digest"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "scope": {"enum": ["repo", "global"]},
        "registry_schema_version": {"type": "integer", "minimum": 1},
        "variant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "created_at": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z$"},
    "format": {"type": "string", "pattern": "^[a-z0-9]{1,10}$"},
    "kind": {"$ref": "#/$defs/slug"},
    "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/relativePath"}]},
    "producer": {"$ref": "#/$defs/slug"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "ref", "root"],
      "properties": {
        "head": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}]},
        "ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 255}]},
        "root": {"const": "."}
      }
    },
    "schema": {"$ref": "#/$defs/slug"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "filename": {"type": "string", "pattern": "^(?!.*-00\\.)[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}T[0-9]{9}Z-[a-z0-9]+(?:-[a-z0-9]+)*(?:-(?:0[1-9]|[1-9][0-9]))?\\.[a-z0-9]{1,10}$", "maxLength": 180},
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:])(?!.*[/]$)[^\\u0000-\\u001f\\u007f]+$",
      "maxLength": 512
    }
  }
}
